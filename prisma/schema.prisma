// Prisma schema do sistema de filas da clínica

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TicketStatus {
  WAITING // aguardando na fila
  CALLED // chamado, aguardando comparecer ao guichê/consultório
  IN_SERVICE // em atendimento
  DONE // atendimento concluído
  NO_SHOW // não compareceu quando chamado
  CANCELLED // senha cancelada
}

model Staff {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

enum AppointmentStatus {
  SCHEDULED // consulta marcada, paciente ainda não chegou
  CHECKED_IN // paciente chegou e recebeu senha
  CANCELLED // consulta cancelada
}

model Queue {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  // tempo médio de atendimento (minutos) usado como estimativa inicial,
  // antes de haver dados históricos suficientes nesta fila
  defaultServiceMins Int      @default(15)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  tickets      Ticket[]
  appointments Appointment[]
}

model Ticket {
  id            String       @id @default(cuid())
  // número sequencial da senha dentro da fila (reinicia a cada dia)
  number         Int
  patientName   String
  // WhatsApp do paciente em formato E.164 sem "+" (ex: 5511998887777).
  // Nunca é exposto nas rotas públicas de consulta.
  phone         String?
  status        TicketStatus @default(WAITING)

  queueId       String
  queue         Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())
  calledAt      DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  // quando o aviso de WhatsApp da chamada foi enviado com sucesso
  notifiedAt    DateTime?

  @@index([queueId, status])
  @@index([queueId, createdAt])

  appointment Appointment?
}

model Appointment {
  id          String            @id @default(cuid())
  patientName String
  // WhatsApp é obrigatório aqui: sem ele não há lembrete a enviar.
  phone       String
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)

  queueId String
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  // senha emitida quando o paciente chega (check-in)
  ticketId String? @unique
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  checkedInAt DateTime?

  reminders AppointmentReminder[]

  @@index([status, scheduledAt])
}

// Um registro por lembrete previsto. A chave única impede que o disparador,
// ao rodar duas vezes, mande a mesma mensagem de novo.
model AppointmentReminder {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // qual marca da régua este registro consome (ex: 180, 30, 5)
  minutesBefore Int
  // preenchido quando a mensagem saiu; nulo quando a marca foi consumida sem
  // envio, por já ter passado quando o disparador rodou
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, minutesBefore])
}

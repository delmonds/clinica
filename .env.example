DATABASE_URL="file:./dev.db"

# Segredo usado para assinar a sessão de login da recepção.
# Gere um valor aleatório com: openssl rand -hex 32
AUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# Credenciais do usuário de recepção criado pelo `npm run db:seed` (opcional).
# STAFF_USERNAME="recepcao"
# STAFF_PASSWORD="troque-esta-senha"
# STAFF_NAME="Recepção"

# Aviso por WhatsApp (Twilio) quando a senha é chamada.
# Sem estas três variáveis o sistema roda em modo simulado: as mensagens só
# aparecem no log do servidor. Preencha as três para enviar de verdade.
# O número do sandbox da Twilio é +14155238886.
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="seu-auth-token"
# TWILIO_WHATSAPP_FROM="+14155238886"

# Segredo que o cron usa para chamar POST /api/reminders/run.
# Gere com: openssl rand -hex 32
CRON_SECRET="troque-por-um-valor-aleatorio-longo"

# Régua dos lembretes de consulta marcada. O padrão manda de 30 em 30 minutos
# a partir de 3h antes e, na última meia hora, de 5 em 5 (11 mensagens).
# Aumente os intervalos para reduzir o volume.
# REMINDER_LEAD_MINUTES="180"
# REMINDER_STEP_MINUTES="30"
# REMINDER_FINAL_WINDOW_MINUTES="30"
# REMINDER_FINAL_STEP_MINUTES="5"

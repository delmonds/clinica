DATABASE_URL="file:./dev.db"

# Segredo usado para assinar a sessão de login da recepção.
# Gere um valor aleatório com: openssl rand -hex 32
AUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# Credenciais do usuário de recepção criado pelo `npm run db:seed` (opcional).
# STAFF_USERNAME="recepcao"
# STAFF_PASSWORD="troque-esta-senha"
# STAFF_NAME="Recepção"

# Aviso por WhatsApp (Twilio) quando a senha é chamada.
# Sem estas três variáveis o sistema roda em modo simulado: as mensagens só
# aparecem no log do servidor. Preencha as três para enviar de verdade.
# O número do sandbox da Twilio é +14155238886.
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="seu-auth-token"
# TWILIO_WHATSAPP_FROM="+14155238886"

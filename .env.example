DATABASE_URL="file:./dev.db"

# Segredo usado para assinar a sessão de login da recepção.
# Gere um valor aleatório com: openssl rand -hex 32
AUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# Credenciais do usuário de recepção criado pelo `npm run db:seed` (opcional).
# STAFF_USERNAME="recepcao"
# STAFF_PASSWORD="troque-esta-senha"
# STAFF_NAME="Recepção"

# Aviso por WhatsApp quando a senha é chamada.
# Sem esta variável (ou com "false") o sistema roda em modo simulado: as
# mensagens só aparecem no log do servidor. Só mude para "true" depois de
# implementar o envio do seu provedor em src/lib/whatsapp.ts.
# WHATSAPP_ENABLED="false"
